<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>Issue20Tests.Suite</StartupObject>
    <FillingSource Condition="'$(FillingSource)' == ''">../../src/Rules/H2Filling.cs</FillingSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tools/watersim/src/*.cs" />
    <Compile Include="$(FillingSource)" />
    <!-- the baseline build (run.ps1 -Baseline) compiles an older H2Filling.cs without the release rule -->
    <Compile Include="../../src/Rules/H2Release.cs" Condition="!$(DefineConstants.Contains('BASELINE'))" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
